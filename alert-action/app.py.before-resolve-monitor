# ============================================================

# ALERTMANAGER WEBHOOK

# ============================================================


@app.route(

    "/alertmanager",

    methods=["POST"]
)

def alertmanager():


    try:


        data = request.get_json()


        logger.info(

            "Alertmanager webhook received"

        )



        status = data.get(
            "status",
            "firing"

        )



        # ----------------------------------------------------
        # PROCESS EVERY ALERT

        # ----------------------------------------------------


        for alert in data.get(
            "alerts",

            []

        ):


            labels = alert.get(
                "labels",
                {}
            )


            severity = labels.get(
                "severity",

                "warning"

            )



            fingerprint = alert.get(
                "fingerprint",
                ""
            )



            # ------------------------------------------------

            # SELECT CHANNEL

            # ------------------------------------------------


            if severity == "critical":

                channel = CRITICAL_CHANNEL


            else:


                channel = WARNING_CHANNEL



            # =================================================

            # FIRING

            # =================================================


            if status == "firing":

                text, blocks = build_alert_message(


                    alert,

                    "firing"

                )



                # ---------------------------------------------

                # SEND SLACK MESSAGE
                # ---------------------------------------------


                response = slack.chat_postMessage(


                    channel=channel,


                    text=text,


                    blocks=blocks

                )



                # ---------------------------------------------

                # SAVE ORIGINAL SLACK MESSAGE
                # ---------------------------------------------


                existing_ack = get_acknowledgement(

                    fingerprint

                )



                if not existing_ack:

                    save_acknowledgement(

                        fingerprint,


                        {


                            "action":

                                "not_acknowledged",


                            "channel_id":
                                channel,


                            "message_ts":
                                response["ts"],

                            "fingerprint":
                                fingerprint,


                            "alert":

                                labels.get(
                                    "alertname",

                                    "Unknown"
                                ),


                            "server":

                                labels.get(

                                    "instance",
                                    "Unknown"

                                ),

                            "severity":
                                labels.get(
                                    "severity",
                                    "unknown"

                                )


                        }


                    )



                logger.info(


                    f"Slack firing message sent: "

                    f"channel={channel}, "

                    f"ts={response['ts']}, "
                    f"fingerprint={fingerprint}"


                )



            # =================================================
            # RESOLVED

            # =================================================


            else:


                acknowledgement = (

                    get_acknowledgement(

                        fingerprint

                    )

                )



                # ---------------------------------------------

                # RESOLVED TIME

                # ---------------------------------------------


                resolved_at = datetime.now(
                    timezone.utc
                ).strftime(

                    "%Y-%m-%d %H:%M:%S UTC"
                )



                # ---------------------------------------------

                # BUILD RESOLVED MESSAGE

                # ---------------------------------------------

                text, blocks = build_alert_message(


                    alert,


                    "resolved",


                    acknowledgement


                )



                # ---------------------------------------------

                # TRY TO UPDATE ORIGINAL MESSAGE

                # ---------------------------------------------


                updated_original = False



                if acknowledgement:


                    original_channel = (

                        acknowledgement.get(
                            "channel_id"
                        )
                    )


                    original_ts = (

                        acknowledgement.get(

                            "message_ts"
                        )

                    )



                    if (
                        original_channel
                        and original_ts

                    ):


                        try:


                            client_response = (

                                slack.chat_update(


                                    channel=original_channel,


                                    ts=original_ts,


                                    text=text,

                                    blocks=blocks

                                )

                            )



                            updated_original = (

                                client_response.get(

                                    "ok",
                                    False
                                )

                            )



                        except Exception as update_error:


                            logger.warning(

                                f"Could not update "
                                f"original Slack message: "
                                f"{update_error}"


                            )



                # ---------------------------------------------

                # FALLBACK: SEND NEW RESOLVED MESSAGE

                # ---------------------------------------------


                if not updated_original:


                    response = slack.chat_postMessage(


                        channel=channel,


                        text=text,


                        blocks=blocks


                    )



                    logger.info(


                        f"Slack resolved message sent: "

                        f"channel={channel}, "
                        f"ts={response['ts']}, "
                        f"fingerprint={fingerprint}"


                    )


                else:

                    logger.info(


                        f"Original Slack message updated "

                        f"to RESOLVED: "

                        f"fingerprint={fingerprint}"


                    )


                # ---------------------------------------------
                # RESOLVED AUDIT LOG
                # ---------------------------------------------


                if acknowledgement:


                    logger.info(


                        f"ALERT_RESOLVED "

                        f"alert={labels.get('alertname', 'Unknown')} "

                        f"server={labels.get('instance', 'Unknown')} "

                        f"severity={labels.get('severity', 'unknown')} "

                        f"fingerprint={fingerprint} "
                        f"ack_action={acknowledgement.get('action')} "
                        f"ack_user={acknowledgement.get('user_name')} "
                        f"ack_user_id={acknowledgement.get('user_id')} "
                        f"ack_at={acknowledgement.get('action_at')} "

                        f"resolved_at={resolved_at}"


                    )


                else:


                    logger.info(


                        f"ALERT_RESOLVED "

                        f"alert={labels.get('alertname', 'Unknown')} "

                        f"server={labels.get('instance', 'Unknown')} "
                        f"severity={labels.get('severity', 'unknown')} "
                        f"fingerprint={fingerprint} "

                        f"ack_action=not_acknowledged "

                        f"resolved_at={resolved_at}"


                    )



        return jsonify(


            {
                "ok": True
            }

        )



    except Exception as e:


        logger.error(

            f"ERROR processing Alertmanager webhook: {e}"

        )



        return jsonify(

            {
                "ok": False,

                "error": str(e)

            }


        ), 500



