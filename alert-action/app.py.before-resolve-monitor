# ============================================================
# ACKNOWLEDGEMENT STATE
# ============================================================

ACK_STATE_FILE = "/var/lib/alert-action/acknowledgements.json"

os.makedirs(
    os.path.dirname(ACK_STATE_FILE),
    exist_ok=True
)

ACK_STATE_LOCK = threading.Lock()


def load_acknowledgements():

    try:

        if not os.path.exists(ACK_STATE_FILE):
            return {}

        with open(
            ACK_STATE_FILE,
            "r"
        ) as f:

            return json.load(f)

    except Exception as e:

        logger.error(
            f"ERROR loading acknowledgement state: {e}"
        )

        return {}


def save_acknowledgements(data):

    try:

        temp_file = f"{ACK_STATE_FILE}.tmp"

        with open(
            temp_file,
            "w"
        ) as f:

            json.dump(
                data,
                f,
                indent=2
            )

        os.replace(
            temp_file,
            ACK_STATE_FILE
        )

    except Exception as e:

        logger.error(
            f"ERROR saving acknowledgement state: {e}"
        )


def save_acknowledgement(
    fingerprint,
    data
):

    with ACK_STATE_LOCK:

        acknowledgements = load_acknowledgements()

        acknowledgements[fingerprint] = data

        save_acknowledgements(
            acknowledgements
        )


def get_acknowledgement(fingerprint):

    with ACK_STATE_LOCK:

        acknowledgements = load_acknowledgements()

        return acknowledgements.get(
            fingerprint
        )


