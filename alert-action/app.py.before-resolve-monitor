# ============================================================
# BUILD SLACK ALERT MESSAGE
# ============================================================

def build_alert_message(
    alert,
    status,
    acknowledgement=None
):

    labels = alert.get(
        "labels",
        {}
    )

    annotations = alert.get(
        "annotations",
        {}
    )

    alertname = labels.get(
        "alertname",
        "Unknown"
    )

    severity = labels.get(
        "severity",
        "unknown"
    ).upper()

    instance = labels.get(
        "instance",
        "Unknown"
    )

    summary = annotations.get(
        "summary",
        ""
    )

    description = annotations.get(
        "description",
        ""
    )

    starts_at = alert.get(
        "startsAt",
        ""
    )

    ends_at = alert.get(
        "endsAt",
        ""
    )


    # ========================================================
    # FIRING
    # ========================================================

    if status == "firing":

        title = (
            "🚨 ALERT FIRING — "
            "Production Monitoring"
        )

        status_text = "🔴 FIRING"


    # ========================================================
    # RESOLVED
    # ========================================================

    else:

        title = (
            "✅ ALERT RESOLVED — "
            "Production Monitoring"
        )

        status_text = "🟢 RESOLVED"


    # ========================================================
    # BASE TEXT
    # ========================================================

    text = (

        f"*{title}*\n\n"

        f"*Alert:* {alertname}\n"

        f"*Severity:* {severity}\n"

        f"*Server:* {instance}\n\n"

        f"*Summary:* {summary}\n\n"

        f"*Description:*\n"
        f"{description}\n\n"

        f"*Started:* {starts_at}\n\n"

    )


    # ========================================================
    # RESOLVED ACKNOWLEDGEMENT INFORMATION
    # ========================================================

    if status == "resolved":

        if acknowledgement:

            action = acknowledgement.get(
                "action",
                "unknown"
            )

            user_name = acknowledgement.get(
                "user_name",
                "Unknown"
            )

            action_at = acknowledgement.get(
                "action_at",
                "Unknown"
            )

            if action == "accepted":

                text += (
                    "✅ *Acknowledgement:* ACCEPTED\n\n"

                    f"*Acknowledged by:* "
                    f"{user_name}\n\n"

                    f"*Acknowledged at:* "
                    f"{action_at}\n\n"
                )

            elif action == "rejected":

                text += (
                    "⚠️ *Acknowledgement:* REJECTED\n\n"

                    f"*Rejected by:* "
                    f"{user_name}\n\n"

                    f"*Rejected at:* "
                    f"{action_at}\n\n"
                )

        else:

            text += (
                "ℹ️ *Acknowledgement:* "
                "NOT ACKNOWLEDGED\n\n"
            )


        if ends_at:

            text += (
                f"*Resolved at:* "
                f"{ends_at}\n\n"
            )

        text += (
            f"*Status:* {status_text}"
        )


    # ========================================================
    # FIRING TEXT
    # ========================================================

    else:

        text += (
            f"*Status:* {status_text}"
        )


    # ========================================================
    # BLOCKS
    # ========================================================

    blocks = [

        {
            "type": "section",

            "text": {
                "type": "mrkdwn",
                "text": text
            }

        }

    ]


    # ========================================================
    # BUTTONS ONLY FOR FIRING
    # ========================================================

    if status == "firing":

        blocks.append(

            {
                "type": "actions",

                "elements": [

                    {
                        "type": "button",

                        "text": {
                            "type": "plain_text",
                            "text": "ACCEPT"
                        },

                        "style": "primary",

                        "action_id": "accept_alert",

                        "value": alert.get(
                            "fingerprint",
                            ""
                        )
                    },

                    {
                        "type": "button",

                        "text": {
                            "type": "plain_text",
                            "text": "REJECT"
                        },

                        "style": "danger",

                        "action_id": "reject_alert",

                        "value": alert.get(
                            "fingerprint",
                            ""
                        )
                    }

                ]
            }

        )


    return text, blocks


# ============================================================
# CREATE ALERTMANAGER SILENCE
# ============================================================

def create_alertmanager_silence(
    labels,
    user_name
):

    matchers = []


    # --------------------------------------------------------
    # CREATE MATCHERS
    # --------------------------------------------------------

    for name, value in labels.items():

        matchers.append(

            {
                "name": name,
                "value": value,
                "isRegex": False
            }

        )


    # --------------------------------------------------------
    # SILENCE TIME
    # --------------------------------------------------------

    starts_at = datetime.now(
        timezone.utc
    )

    ends_at = starts_at + timedelta(
        hours=4
    )


    # --------------------------------------------------------
    # SILENCE PAYLOAD
    # --------------------------------------------------------

    silence = {

        "matchers": matchers,

        "startsAt":
            starts_at.isoformat(),

        "endsAt":
            ends_at.isoformat(),

        "createdBy":
            user_name,

        "comment":
            f"Alert acknowledged by "
            f"{user_name} via Slack"

    }


    logger.info(
        f"Creating Alertmanager silence "
        f"user={user_name} "
        f"silence_start={starts_at.isoformat()} "
        f"silence_end={ends_at.isoformat()}"
    )


    # --------------------------------------------------------
    # SEND TO ALERTMANAGER
    # --------------------------------------------------------

    response = requests.post(

        f"{ALERTMANAGER_URL}/api/v2/silences",

        json=silence,

        timeout=10

    )


    response.raise_for_status()


    result = response.json()


    silence_id = result.get(
        "silenceID"
    )


    logger.info(
        f"Alertmanager silence created "
        f"silence_id={silence_id}"
    )


    return silence_id


# ============================================================
# GET ALERT BY FINGERPRINT
# ============================================================

def get_alert_by_fingerprint(
    fingerprint
):

    response = requests.get(

        f"{ALERTMANAGER_URL}/api/v2/alerts",

        timeout=10

    )

    response.raise_for_status()

    alerts = response.json()


    for alert in alerts:

        if alert.get(
            "fingerprint"
        ) == fingerprint:

            return alert


    return None


# ============================================================
# ACCEPT BUTTON
# ============================================================

@bolt_app.action("accept_alert")
def accept_alert(
    ack,
    body,
    client
):

    ack()


    try:

        # ----------------------------------------------------
        # SLACK USER
        # ----------------------------------------------------

        user_id = body["user"]["id"]

        user_name = body["user"].get(
            "name",
            "Unknown"
        )


        # ----------------------------------------------------
        # SLACK MESSAGE
        # ----------------------------------------------------

        channel_id = body["channel"]["id"]

        message_ts = body["message"]["ts"]


        # ----------------------------------------------------
        # FINGERPRINT
        # ----------------------------------------------------

        fingerprint = body["actions"][0].get(
            "value",
            ""
        )


        logger.info(
            f"ACCEPT_CLICKED "
            f"user={user_name} "
            f"user_id={user_id} "
            f"fingerprint={fingerprint}"
        )


        # ----------------------------------------------------
        # GET ALERT
        # ----------------------------------------------------

        alert = get_alert_by_fingerprint(
            fingerprint
        )


        if not alert:

            logger.warning(
                f"ALERT_NOT_FOUND "
                f"user={user_name} "
                f"user_id={user_id} "
                f"fingerprint={fingerprint}"
            )


            client.chat_update(

                channel=channel_id,

                ts=message_ts,

                text="Alert no longer active",

                blocks=[

                    {
                        "type": "section",

                        "text": {

                            "type": "mrkdwn",

                            "text": (
                                "⚠️ *Alert no longer active*\n\n"
                                "The alert could not be found "
                                "in Alertmanager."
                            )

                        }

                    }

                ]

            )

            return


        # ----------------------------------------------------
        # LABELS
        # ----------------------------------------------------

        labels = alert.get(
            "labels",
            {}
        )


        # ----------------------------------------------------
        # CREATE SILENCE
        # ----------------------------------------------------

        silence_id = create_alertmanager_silence(

            labels,

            user_name

        )


        # ----------------------------------------------------
        # TIMES
        # ----------------------------------------------------

        now = datetime.now(
            timezone.utc
        )

        acknowledged_at = now.strftime(
            "%Y-%m-%d %H:%M:%S UTC"
        )

        renotify_time = (
            now + timedelta(hours=4)
        )


        # ----------------------------------------------------
        # SAVE ACKNOWLEDGEMENT
        # ----------------------------------------------------

        acknowledgement = {

            "action": "accepted",

            "user_name": user_name,

            "user_id": user_id,

            "action_at": acknowledged_at,

            "channel_id": channel_id,

            "message_ts": message_ts,

            "alert": labels.get(
                "alertname",
                "Unknown"
            ),

            "server": labels.get(
                "instance",
                "Unknown"
            ),

            "severity": labels.get(
                "severity",
                "unknown"
            ),

            "fingerprint": fingerprint,

            "silence_id": silence_id,

            "renotify_at":
                renotify_time.isoformat()

        }


        save_acknowledgement(

            fingerprint,

            acknowledgement

        )


        # ----------------------------------------------------
        # UPDATE SLACK MESSAGE
        # ----------------------------------------------------

        client.chat_update(

            channel=channel_id,

            ts=message_ts,

            text="Alert acknowledged",

            blocks=[

                {

                    "type": "section",

                    "text": {

                        "type": "mrkdwn",

                        "text": (

                            "🚨 *ALERT FIRING — "
                            "Production Monitoring*\n\n"

                            "✅ *Acknowledged*\n\n"

                            f"*Acknowledged by:* "
                            f"{user_name}\n\n"

                            f"*Acknowledged at:* "
                            f"{acknowledged_at}\n\n"

                            "*Re-notification:* "
                            "in 4 hours if still firing\n\n"

                            f"*Silence ID:* "
                            f"`{silence_id}`"

                        )

                    }

                }

            ]

        )


        # ----------------------------------------------------
        # AUDIT LOG
        # ----------------------------------------------------

        logger.info(

            f"ALERT_ACCEPTED "
            f"user={user_name} "
            f"user_id={user_id} "
            f"alert={labels.get('alertname', 'Unknown')} "
            f"server={labels.get('instance', 'Unknown')} "
            f"severity={labels.get('severity', 'unknown')} "
            f"fingerprint={fingerprint} "
            f"silence_id={silence_id} "
            f"renotify_at={renotify_time.isoformat()}"

        )


    except Exception as e:

        logger.error(
            f"ERROR while accepting alert: {e}"
        )


